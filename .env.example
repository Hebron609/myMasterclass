# Suite API base; dashboard endpoints append /v1. Do not include /v1 here.
API_BASE_URL=https://appsuite.butterflytech.io/api
NEXT_PUBLIC_APP_URL=https://your-production-domain.com
NEXT_PUBLIC_ENABLE_TOKEN_TOOL=false

# Secret for signing OTP & password-reset tokens (generate a random 64-char hex string)
APP_SIGNING_SECRET=

# Email / Transactional Mailer (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=dibaleagleship@gmail.com
SMTP_PASS=
SMTP_FROM_NAME="Diba Leagleship Institute"
